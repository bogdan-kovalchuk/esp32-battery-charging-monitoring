#pragma once

// Copy this file to `secrets.h` and fill in real values:
//
//     cp firmware/include/secrets.h.example firmware/include/secrets.h
//
// `secrets.h` is gitignored — never commit it.
//
// These values are COMPILE-TIME DEFAULTS ONLY. They seed NVS on the very first
// boot and are what a 10 s button hold restores. The values actually used at
// runtime live in NVS and are edited through the web UI, so changing anything
// here has no effect on an already-provisioned device until it is reset.
//
// The build refuses to compile while any placeholder below is left in place
// (see the static_assert block at the top of src/device_config.cpp).

#define WIFI_SSID        "CHANGE_ME"
#define WIFI_PASSWORD    "CHANGE_ME"

// Backend hostname or IP. Do not include http(s):// or /send.
#define SERVER_HOST      "CHANGE_ME"
#define SERVER_PORT      5000

// Optional HTTPS. Set SERVER_USE_TLS to 1, normally use port 443, and paste
// the PEM CA root that validates the server certificate. Do not use
// setInsecure().
#define SERVER_USE_TLS   0
#define SERVER_ROOT_CA   ""

// Fallback access point, raised when WiFi is unreachable for WIFI_TIMEOUT_MS.
// WPA2 requires at least 8 characters.
#define AP_SSID          "BCM-AP"
#define AP_PASSWORD      "CHANGE_ME"

#define DEVICE_ID        "BATT#1"

// Bearer token for POST /send. Must match API_TOKEN in server/.env exactly.
// Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#define API_TOKEN        "CHANGE_ME"

// Credentials for the on-device configuration web UI (HTTP Basic Auth).
#define WEB_USER         "admin"
#define WEB_PASSWORD     "CHANGE_ME"

// Battery voltage at or below which an ALERT is sent instead of an INFO.
#define CRIT_VOLTAGE     11.0f

// Minutes between repeated messages of each kind.
#define INFO_INTERVAL    300
#define CRIT_INTERVAL    120
