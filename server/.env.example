# Copy to server/.env and fill in. server/.env is gitignored — never commit it.
#
#     cp server/.env.example server/.env
#
# This file is the answer to "where does the backend get its settings from".
# It is looked up in this order, first hit wins:
#
#   1. the env_file argument to load_config()      — used by the tests
#   2. $BATTERY_MONITOR_ENV                        — absolute path, for secrets
#                                                    kept outside the checkout
#   3. server/.env                                 — resolved relative to the
#                                                    package, NOT to the
#                                                    process working directory
#
# Real environment variables always override the file, so a systemd
# `Environment=` line or a container secret wins over what is written here.
#
# Every value below without a default is REQUIRED: the service refuses to start
# rather than run with a missing or placeholder credential.

# --- Signal identity (required) ---------------------------------------------

# The phone number registered with signal-cli, in E.164 format, e.g.
# +380501234567. This is the account messages are sent FROM. Left blank on
# purpose: a filled-in example would validate cleanly and send from a number
# that does not exist.
#   signal-cli -a +380501234567 register
SIGNAL_USER=

# The Signal group messages are sent TO. Find it with:
#   signal-cli -a +380501234567 listGroups
SIGNAL_GROUP_ID=

# --- Authentication (required) ----------------------------------------------

# Shared secret for POST /send. Must match API_TOKEN in
# firmware/include/secrets.h exactly. At least 16 characters, and it may not be
# any of the placeholders published in this repository.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# --- Network ----------------------------------------------------------------

# Default 127.0.0.1: bind to loopback and let nginx terminate TLS in front.
# Set 0.0.0.0 only if you really intend to expose the service directly — the
# API token then crosses the network in cleartext.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# --- signal-cli -------------------------------------------------------------

SIGNAL_CLI_BIN=signal-cli

# Durable SQLite outbox. In systemd use a service-writable state directory,
# e.g. /var/lib/battery-monitor/outbox.sqlite3. Relative paths resolve from
# server/, not from the process working directory.
OUTBOX_DB_PATH=.data/outbox.sqlite3

# Seconds a looked-up version stays cached. Without caching, every /metrics
# scrape would shell out to signal-cli and call the GitHub API, which exhausts
# GitHub's 60-requests-per-hour unauthenticated limit within minutes.
LOCAL_VERSION_TTL=300
LATEST_VERSION_TTL=3600

# --- Hardening --------------------------------------------------------------

# Largest accepted request body in bytes. The ESP32 posts well under 1 KB.
MAX_CONTENT_LENGTH=4096

# /send always requires the token. These two are separate because monitoring
# systems often cannot send an Authorization header, while leaving /metrics
# open exposes the signal-cli version to anyone who can reach the port.
METRICS_REQUIRE_AUTH=true
HEALTHCHECK_REQUIRE_AUTH=false

# Consecutive send failures before /healthcheck reports unhealthy. Consecutive,
# not total: a total counter never resets, so one transient failure would pin
# the endpoint at an error forever.
UNHEALTHY_AFTER_FAILURES=3
